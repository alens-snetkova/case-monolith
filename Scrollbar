import * as React from "react"
import { addPropertyControls, ControlType } from "framer"

/**
 * CustomScrollbar
 * Кастомный вертикальный индикатор прокрутки с плавной анимацией (lerp) 
 * и поддержкой drag-and-drop (мышь и тач).
 * Разработан как Code Component для Framer.
 */
export function CustomScrollbar(props: any) {
    const { lineColor, trackColor, lineWidth } = props
    
    // Ссылки на DOM-элементы для прямой манипуляции стилями (минуя ререндеры React)
    const trackRef = React.useRef<HTMLDivElement>(null)
    const progressRef = React.useRef<HTMLDivElement>(null)
    
    const [isVisible, setIsVisible] = React.useState(false)
    const [isDragging, setIsDragging] = React.useState(false)
    
    // Используем useRef для координат драга, чтобы избежать проблем с замыканиями (stale closures) 
    // внутри обработчиков событий window и не вызывать лишние ререндеры.
    const dragStartY = React.useRef(0)
    const dragStartScroll = React.useRef(0)
    const animationRef = React.useRef<number>()

    // 1. Логика появления/скрытия скроллбара
    React.useEffect(() => {
        const homeSection = document.querySelector("#home")

        const checkVisibility = () => {
            if (!homeSection) {
                setIsVisible(true)
                return
            }
            // Показываем скроллбар, когда прокрутили ниже первого экрана (#home) минус 100px
            const homeBottom = homeSection.offsetTop + homeSection.offsetHeight
            setIsVisible(window.scrollY > homeBottom - 100)
        }

        checkVisibility()
        // ВАЖНО: { passive: true } сообщает браузеру, что мы не будем вызывать e.preventDefault(),
        // что позволяет выполнять скролл в основном потоке без задержек (оптимизация производительности).
        window.addEventListener("scroll", checkVisibility, { passive: true })
        return () => window.removeEventListener("scroll", checkVisibility)
    }, [])

    // 2. Плавная анимация прогресса (Linear Interpolation / Lerp)
    React.useEffect(() => {
        let currentScroll = 0
        const ease = 0.1 // Коэффициент плавности (чем меньше, тем более "вязкой" будет анимация)

        const animate = () => {
            // Если пользователь не тащит ползунок вручную, применяем плавное следование за скроллом
            if (!isDragging && progressRef.current) {
                const scrollTop = window.scrollY
                const docHeight = document.documentElement.scrollHeight - window.innerHeight
                const targetScroll = docHeight > 0 ? scrollTop / docHeight : 0

                // Формула Lerp: текущее значение сдвигается к целевому на долю (ease) каждый кадр
                currentScroll += (targetScroll - currentScroll) * ease
                progressRef.current.style.transform = `scaleY(${currentScroll})`
            }

            animationRef.current = requestAnimationFrame(animate)
        }

        animationRef.current = requestAnimationFrame(animate)
        
        // Очистка цикла анимации при размонтировании
        return () => {
            if (animationRef.current) cancelAnimationFrame(animationRef.current)
        }
    }, [isDragging])

    // 3. Мгновенное обновление прогресса (резервный/синхронный метод, если нужен вне цикла анимации)
    const updateProgress = React.useCallback(() => {
        if (progressRef.current && !isDragging) {
            const scrollTop = window.scrollY
            const docHeight = document.documentElement.scrollHeight - window.innerHeight
            const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0
            progressRef.current.style.transform = `scaleY(${scrollPercent})`
        }
    }, [isDragging])

    // 4. Обработка клика по треку (мгновенный переход к секции)
    const handleTrackClick = React.useCallback(
        (e: React.MouseEvent) => {
            if (isDragging || !trackRef.current) return

            const rect = trackRef.current.getBoundingClientRect()
            // Вычисляем процент высоты, на который кликнули (от 0.0 до 1.0)
            const clickPosition = (e.clientY - rect.top) / rect.height
            const docHeight = document.documentElement.scrollHeight - window.innerHeight

            window.scrollTo({
                top: clickPosition * docHeight,
                behavior: "smooth",
            })
        },
        [isDragging]
    )

    // 5. Логика Drag-and-Drop (универсальная для мыши и тача)
    const startDrag = React.useCallback((clientY: number) => {
        setIsDragging(true)
        dragStartY.current = clientY
        dragStartScroll.current = window.scrollY
    }, [])

    const moveDrag = React.useCallback((clientY: number) => {
        if (!trackRef.current) return

        const rect = trackRef.current.getBoundingClientRect()
        const deltaY = clientY - dragStartY.current
        
        // Преобразуем смещение мыши в пикселях в смещение скролла документа
        const trackHeight = rect.height
        const docHeight = document.documentElement.scrollHeight - window.innerHeight
        const scrollDelta = (deltaY / trackHeight) * docHeight
        const newScroll = dragStartScroll.current + scrollDelta

        // Мгновенный скролл без плавности (для точного контроля пользователем)
        window.scrollTo(0, newScroll)

        // Мгновенное обновление визуального ползунка
        if (progressRef.current) {
            const scrollPercent = docHeight > 0 ? newScroll / docHeight : 0
            progressRef.current.style.transform = `scaleY(${scrollPercent})`
        }
    }, [])

    const endDrag = React.useCallback(() => {
        setIsDragging(false)
    }, [])

    // 6. Привязка событий Мыши
    const handleMouseDown = React.useCallback(
        (e: React.MouseEvent) => {
            e.preventDefault() // Предотвращаем выделение текста при начале перетаскивания
            startDrag(e.clientY)
        },
        [startDrag]
    )

    React.useEffect(() => {
        if (!isDragging) return

        // ВАЖНО: События вешаются на window, а не на элемент. 
        // Это позволяет не терять захват (drag), если курсор мыши случайно вышел за пределы узкого трека.
        const handleMouseMove = (e: MouseEvent) => moveDrag(e.clientY)
        const handleMouseUp = () => endDrag()

        window.addEventListener("mousemove", handleMouseMove)
        window.addEventListener("mouseup", handleMouseUp)

        return () => {
            window.removeEventListener("mousemove", handleMouseMove)
            window.removeEventListener("mouseup", handleMouseUp)
        }
    }, [isDragging, moveDrag, endDrag])

    // 7. Привязка событий Touch (для мобильных устройств)
    const handleTouchStart = React.useCallback(
        (e: React.TouchEvent) => {
            startDrag(e.touches[0].clientY)
        },
        [startDrag]
    )

    React.useEffect(() => {
        if (!isDragging) return

        const handleTouchMove = (e: TouchEvent) => {
            e.preventDefault() // Блокируем нативный скролл страницы во время перетаскивания ползунка
            moveDrag(e.touches[0].clientY)
        }
        const handleTouchEnd = () => endDrag()

        // passive: false обязателен, чтобы работало e.preventDefault() внутри touchmove
        window.addEventListener("touchmove", handleTouchMove, { passive: false })
        window.addEventListener("touchend", handleTouchEnd)

        return () => {
            window.removeEventListener("touchmove", handleTouchMove)
            window.removeEventListener("touchend", handleTouchEnd)
        }
    }, [isDragging, moveDrag, endDrag])

    return (
        <>
            <style>{`
                .custom-scrollbar-wrapper {
                    position: fixed;
                    right: 10px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 24px; /* Зона клика шире визуальной линии для удобства */
                    height: 60vh;
                    z-index: 9999;
                    cursor: pointer;
                    opacity: 0;
                    transition: opacity 0.4s ease;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .custom-scrollbar-wrapper.visible {
                    opacity: 1;
                }

                .custom-scrollbar-track {
                    width: ${lineWidth}px;
                    height: 100%;
                    background-color: ${trackColor || "rgba(10, 10, 10, 0.1)"};
                    position: relative;
                    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                    transform-origin: center;
                }

                /* Микро-взаимодействие: расширение трека при наведении */
                .custom-scrollbar-wrapper:hover .custom-scrollbar-track {
                    transform: scaleX(2.5);
                }

                .custom-scrollbar-progress {
                    width: 100%;
                    height: 100%;
                    background-color: ${lineColor || "#0A0A0A"};
                    /* КРИТИЧЕСКИ ВАЖНО: scaleY растет от top к bottom только при transform-origin: top */
                    transform-origin: top;
                    transform: scaleY(0);
                    will-change: transform; /* Подсказка браузеру для GPU-ускорения анимации */
                    position: relative;
                    pointer-events: none; /* Чтобы клики проходили сквозь прогресс-бар к треку */
                }

                /* Адаптивность: Планшет */
                @media (max-width: 1600px) {
                    .custom-scrollbar-wrapper { right: 5px; }
                }

                /* Адаптивность: Мобильные устройства */
                @media (max-width: 809px) {
                    .custom-scrollbar-wrapper {
                        right: 0px;
                        width: 25px;
                    }
                }
            `}</style>

            <div
                ref={trackRef}
                className={`custom-scrollbar-wrapper ${isVisible ? "visible" : ""}`}
                onClick={handleTrackClick}
                onMouseDown={handleMouseDown}
                onTouchStart={handleTouchStart}
            >
                <div className="custom-scrollbar-track">
                    <div
                        ref={progressRef}
                        className="custom-scrollbar-progress"
                    />
                </div>
            </div>
        </>
    )
}

// Регистрация контролов в панели свойств Framer
addPropertyControls(CustomScrollbar, {
    lineColor: {
        type: ControlType.Color,
        defaultValue: "#0A0A0A",
        title: "Line Color",
    },
    trackColor: {
        type: ControlType.Color,
        defaultValue: "rgba(10, 10, 10, 0.1)",
        title: "Track Color",
    },
    lineWidth: {
        type: ControlType.Number,
        defaultValue: 2,
        min: 1,
        max: 6,
        title: "Width (px)",
    },
})
